{
  "name": "bioradar",
  "version": "1.0.0",
  "private": true,
  "description": "BioRadar - eDNA biodiversity intelligence for Indian waters",
  "scripts": {
    "dev": "python -u -m bioradar.webapp --host 0.0.0.0 --port 8080",
    "build:assets": "node -e \"const fs=require('fs'),path=require('path');const src='src/assets',dst='bioradar/webapp_static/assets',dstRoot='bioradar/webapp_static';if(fs.existsSync(src)){if(!fs.existsSync(dst))fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).forEach(f=>{fs.copyFileSync(path.join(src,f),path.join(dst,f));fs.copyFileSync(path.join(src,f),path.join(dstRoot,f));});}\"",
    "build:css": "tailwindcss -i src/styles/home.css -o bioradar/webapp_static/home.css --minify",
    "build:home": "esbuild src/home-entry.tsx --bundle --minify --format=iife --global-name=BioRadarHomeBundle --outfile=bioradar/webapp_static/home-bundle.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "build": "npm run build:assets && npm run build:css && npm run build:home"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3"
  }
}
